<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- Article -->
  <record id="action_blog_article" model="ir.actions.act_window">
    <field name="name">Articles de blog</field>
    <field name="res_model">mon.blog.article</field>
    <field name="view_mode">list,form</field>
  </record>

  <record id="action_blog_tag" model="ir.actions.act_window">
    <field name="name">Tags</field>
    <field name="res_model">mon.blog.tag</field>
    <field name="view_mode">list,form</field>
  </record>

  <record id="action_blog_comment" model="ir.actions.act_window">
    <field name="name">Commentaires</field>
    <field name="res_model">mon.blog.comment</field>
    <field name="view_mode">list,form</field>
  </record>

  <!-- Menu racine -->
  <menuitem id="menu_blog_root"
            name="Blog"
            sequence="100"/>

  <!-- Sous-menus -->
  <menuitem id="menu_blog_articles"
            name="Articles"
            parent="menu_blog_root"
            action="action_blog_article"
            sequence="1"/>

  <menuitem id="menu_blog_tags"
            name="Tags"
            parent="menu_blog_root"
            action="action_blog_tag"
            sequence="2"/>

  <menuitem id="menu_blog_comment"
            name="Commentaires"
            parent="menu_blog_root"
            action="action_blog_comment"
            sequence="3"/>

  <menuitem id="menu_blog_config"
            name="Configuration Blog"
            parent="menu_blog_root"
            action="action_blog_config"
            sequence="4"/>

</odoo>